namespace ProductAPI is
    use interlocked_increment = System.Threading.Interlocked.increment;
    use CONCURRENT_MAP = System.Collections.Concurrent.ConcurrentDictionary;
    use Tasks = System.Threading.Tasks;

    // Async trait — every store method returns a Task so handlers can
    // compose with `let await` / `await` and ASP.NET awaits the result
    // before serialising. The in-memory implementation completes its
    // tasks synchronously via Task.from_result; a real backing store
    // (database, remote service) would be naturally async.
    trait ProductStore is
        create_product(product: PRODUCT) -> Tasks.Task[int];
        get_product(id: int) -> Tasks.Task[PRODUCT];
        update_product(id: int, product: PRODUCT) -> Tasks.Task[bool];
        delete_product(id: int) -> Tasks.Task[bool];
    si

    class IN_MEMORY_PRODUCT_STORE: ProductStore is
        _next_id: int;
        _products: CONCURRENT_MAP[int,PRODUCT];

        init() is
            _next_id = -1;
            _products = CONCURRENT_MAP[int,PRODUCT]();
        si

        create_product(product: PRODUCT) -> Tasks.Task[int] is
            let result = interlocked_increment(_next_id ref);

            _products[result] = product;

            return Tasks.Task.from_result(result);
        si

        get_product(id: int) -> Tasks.Task[PRODUCT] =>
            let result: PRODUCT in
            Tasks.Task.from_result(
                if _products.try_get_value(id, result ref) then
                    result
                else
                    null
                fi
            );

        update_product(id: int, product: PRODUCT) -> Tasks.Task[bool] =>
            // FIXME could return false if product is replaced
            // between try_get_value and try_update, which
            // the calling code will wrongly interpret as 'not found'
            let
                current: PRODUCT,
                exists = _products.try_get_value(id, current ref)
            in
                Tasks.Task.from_result(
                    if exists then
                        _products.try_update(id, product, current)
                    else
                        false
                    fi
                );

        delete_product(id: int) -> Tasks.Task[bool] =>
            let result: PRODUCT in
            Tasks.Task.from_result(_products.try_remove(id, result ref));
    si
si
