namespace ProductAPI is
    // Every store method returns a Task so handlers can compose with
    // `let await` / `await` and ASP.NET awaits the result before
    // serialising. The SQLite-backed implementation in
    // sqlite-product-store.ghul does real async I/O end-to-end.
    trait ProductStore is
        create_product(product: PRODUCT) -> Tasks.TASK[int];
        get_product(id: int) -> Tasks.TASK[PRODUCT];
        update_product(id: int, product: PRODUCT) -> Tasks.TASK[bool];
        delete_product(id: int) -> Tasks.TASK[bool];
    si
si
